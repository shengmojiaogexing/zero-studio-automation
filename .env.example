# Zero Studio Automation Environment Variables

# 内部服务间通信鉴权密钥（用于 X-API-Key 请求头校验）
INTERNAL_API_KEY=change-me-to-a-strong-secret-key

# 预约网站后台与中控台统一管理员账号密码（严禁使用弱密码暴露公网）
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# PushPlus 微信推送 Token（可选）
PUSHPLUS_TOKEN=

# ==================== Sprint 2 & 2.5: 拷卡、预览 XMP 与全链路服务配置 ====================

# NAS 局域网 SMB UNC 路径（拷卡优先写入，原片始终零修改）
NAS_UNC_PATH=\\192.168.1.100\ZeroStudio\RAW

# NAS 本地映射盘符路径（UNC 不可达时自动回退）
NAS_DRIVE_PATH=Z:\ZeroStudio\RAW

# booking-site 内网接口基础地址（仅限 127.0.0.1 内网调用）
BOOKING_API_URL=http://127.0.0.1:3000

# 2048px WebP 预览图输出目录（同时作为选图 H5 静态资源目录）
PREVIEW_OUTPUT_DIR=D:\zero-studio-automation\apps\booking-site\uploads\previews

# 预览调色预设 XMP 文件路径（仅用于生成客户选图预览 WebP，与正式修图 RETOUCH_XMP_DIR 严格分离）
PREVIEW_XMP_PATH=

# ==================== Sprint 3: IM 统一网关与 DeepSeek 接单大脑 ====================

# DeepSeek API（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# QQ NapCatQQ (OneBot v11)
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_HTTP_URL=http://127.0.0.1:3002
NAPCAT_TOKEN=

# 微信适配器运行模式（desktop: PC微信 wxauto/wxauto4 | web: 网页版预留）
WECHAT_MODE=desktop

# 企业微信客服 Adapter（配置后可无缝切换）
WECOM_CORP_ID=
WECOM_KF_SECRET=
WECOM_KF_TOKEN=
WECOM_KF_ENCODING_AES_KEY=
WECOM_OPEN_KFID=

# 防封安全演练开关（true 时冷却队列仅演练记录，不真正发出加好友请求）
DRY_RUN_ADD_FRIEND=true

# ==================== Sprint 4: 正式修图引擎、Gemini 仿色与终审交付闭环 ====================

# Gemini 多模态仿色大脑配置
GEMINI_API_KEY=
GEMINI_RETOUCH_MODEL=gemini-2.5-pro

# 视觉大脑中转站（可选）：填了 VISION_BASE_URL 就按 OpenAI 兼容协议走中转站，否则走 Google 官方接口
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_FALLBACK_MODELS=

# 正式修图 XMP 预设目录（与 PREVIEW_XMP_PATH 严格分离）
RETOUCH_XMP_DIR=D:\zero-studio-automation\configs\retouch_xmp

# 本地高速修图工作区（存放只读 RAW 转出的 16-bit TIFF 与中间 1024px sRGB 预览）
RETOUCH_WORK_DIR=D:\zero-studio-automation\work\retouch

# 正式精修成片输出目录（由 booking-site 挂载为 /outputs 静态路由）
RETOUCH_OUTPUT_DIR=D:\zero-studio-automation\apps\booking-site\uploads\outputs

# Windows Photoshop 零干预自动化与 UXP 桥接配置
# PS_BACKEND: auto（Windows 优先 COM 自动启停 PS，推荐）| com | uxp
PS_BACKEND=auto
PS_EXE_PATH=
PS_AUTO_LAUNCH=true
PS_AUTO_CLOSE=true
PS_IDLE_CLOSE_SEC=60
PS_UXP_BRIDGE_URL=http://127.0.0.1:8765
PS_UXP_BRIDGE_TOKEN=change-me-ps-uxp-bridge-token

# 后期全自动后台守护开关（studio_supervisor.py 统一拉起）
ENABLE_RETOUCH_WORKER=true
ENABLE_CARD_WATCHER=true
AUTO_WATCH_EVENT_NAME=
AUTO_PUSH_GALLERY=true
INGEST_LOCAL_FALLBACK=true

# 局部蒙版生图/去路人修补 API（仅裁切局部 Patch，严禁整图重绘）
IMAGE_GEN_API_URL=
IMAGE_GEN_API_KEY=

# IM 统一网关内网地址（仅限 127.0.0.1 访问，绝不公网暴露）
IM_GATEWAY_URL=http://127.0.0.1:8090
IM_GATEWAY_PORT=8090

# ==================== Sprint 5: 统一可视化中控台与公网 VPS 穿透 (FRP + XTCP) ====================

# 外网客户选图 / 交付链接公网根地址（优先用于拼装 /gallery/{token} 与 /delivery/{token}）
PUBLIC_BASE_URL=http://156.238.228.39:8080

# 公网 VPS 服务器连接参数（严禁在任何文件或脚本中硬编码 SSH 密码）
VPS_HOST=156.238.228.39
VPS_SSH_PORT=24877
VPS_SSH_USER=root

# FRP 穿透服务端与隧道端口配置
FRP_BIND_PORT=7000
FRP_TOKEN=change-me-strong-frp-token
FRP_PUBLIC_BOOKING_PORT=8080
FRP_PUBLIC_STUDIO_PORT=8081
FRP_XTCP_SECRET=change-me-strong-xtcp-p2p-secret

# 中控台本地端口与 Session Cookie 签名密钥
CONTROL_CENTER_PORT=3080
CONTROL_CENTER_SECRET=change-me-session-signing-secret
